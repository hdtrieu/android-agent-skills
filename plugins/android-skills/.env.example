# Copy to ~/.config/android-agent-skills/.env (or set ANDROID_SKILLS_ENV_FILE).
# Plain NAME=value lines; no shell execution or expansion. Exported variables win.
# A service is enabled when its token is set. Leave unused services empty.

# Jira Cloud: email + API token -> basic auth; token alone -> bearer.
JIRA_BASE_URL=''            # https://YOUR-SITE.atlassian.net/rest/api/3
JIRA_EMAIL=''
JIRA_API_TOKEN=''

# Confluence Cloud v2
CONFLUENCE_BASE_URL=''      # https://YOUR-SITE.atlassian.net/wiki/api/v2
CONFLUENCE_EMAIL=''
CONFLUENCE_API_TOKEN=''

# GitLab (default base https://gitlab.com/api/v4). glab also reads GITLAB_TOKEN.
GITLAB_BASE_URL=''          # https://YOUR-GITLAB/api/v4
GITLAB_TOKEN=''

# Figma (default base https://api.figma.com/v1)
FIGMA_TOKEN=''

# Optional non-secret project context. Repository instructions take precedence.
JIRA_PROJECT_KEY=''         # ABC
CONFLUENCE_SPACE_ID=''
GITLAB_PROJECT=''           # 123 or group/project
FIGMA_FILE_KEY=''
GIT_BASE_BRANCH=''          # develop
GIT_TARGET_BRANCH=''        # develop
BRANCH_PATTERN=''           # feature/{KEY}-{slug}
COMMIT_PATTERN=''           # type(scope): {KEY} summary
